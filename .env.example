# Shared secret for the X-API-Key header — protects all HTTP endpoints.
# This is NOT the same as a per-account api_key (see PLAN.md §2).
API_KEY=

# Port the HTTP service listens on.
PORT=8000

# Host/interface the HTTP service binds to. Defaults to 127.0.0.1
# (localhost-only, see PLAN.md §7) if unset. Only applies to run.py
# (bare-metal/Pyker) -- Docker always binds 0.0.0.0 inside the container
# regardless of this value, see the Dockerfile for why.
HOST=127.0.0.1
